APP_NAME=Sir Device
APP_ENV=production
APP_BASE_URL=https://replace-with-your-domain.example
SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://sir_device:replace-with-a-strong-database-password@database:5432/sir_device
AUTO_CREATE_SCHEMA=false
POSTGRES_DB=sir_device
POSTGRES_USER=sir_device
POSTGRES_PASSWORD=replace-with-a-strong-database-password
WEB_PORT=8000
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
NOTIFICATION_INTERVAL_SECONDS=30
INVENTORY_SYNC_INTERVAL_SECONDS=259200
SESSION_COOKIE_NAME=sir_device_session
CART_COOKIE_NAME=sir_device_cart
CSRF_COOKIE_NAME=sir_device_csrf
SESSION_TTL_MINUTES=720
UPLOAD_BACKEND=local
UPLOAD_DIRECTORY=./var/uploads
MAX_UPLOAD_BYTES=10485760
AWS_REGION=af-south-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=
WHATSAPP_NUMBER=
SALES_TEAM_EMAIL=
PAYMENT_PROVIDER=payfast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_PROCESS_URL=
PAYFAST_VALIDATE_URL=
PAYFAST_ALLOWED_IPS=
