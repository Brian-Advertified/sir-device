APP_NAME=Sir Device
APP_ENV=development
APP_BASE_URL=http://localhost:8000
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./sir_device.db
AUTO_CREATE_SCHEMA=true
POSTGRES_DB=sir_device
POSTGRES_USER=sir_device
POSTGRES_PASSWORD=replace-with-a-strong-database-password
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
SESSION_COOKIE_NAME=sir_device_session
CART_COOKIE_NAME=sir_device_cart
CSRF_COOKIE_NAME=sir_device_csrf
SESSION_TTL_MINUTES=720
UPLOAD_BACKEND=local
UPLOAD_DIRECTORY=./var/uploads
MAX_UPLOAD_BYTES=10485760
AWS_REGION=af-south-1
S3_BUCKET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
SUPPORT_EMAIL=deals@sirdevice.com
SUPPORT_PHONE=
WHATSAPP_NUMBER=
SALES_TEAM_EMAIL=
PAYMENT_PROVIDER=payfast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_PROCESS_URL=
PAYFAST_VALIDATE_URL=
PAYFAST_ALLOWED_IPS=
